{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::938095765653:role/flexexa-dev-charging-api-execution",
        "arn:aws:iam::938095765653:role/flexexa-dev-charging-api-task"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::938095765653:policy/FlexexaChargingTaskBoundaryDev"
        }
      }
    },
    {
      "Sid": "ReadAndTagRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::938095765653:role/flexexa-dev-charging-api-execution",
        "arn:aws:iam::938095765653:role/flexexa-dev-charging-api-task"
      ]
    },
    {
      "Sid": "BoundedExecutionPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::938095765653:role/flexexa-dev-charging-api-execution"
    },
    {
      "Sid": "PassOnlyToEcs",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::938095765653:role/flexexa-dev-charging-api-execution",
        "arn:aws:iam::938095765653:role/flexexa-dev-charging-api-task"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ElbServiceRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "arn:aws:iam::938095765653:role/aws-service-role/elasticloadbalancing.amazonaws.com/AWSServiceRoleForElasticLoadBalancing",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"
        }
      }
    },
    {
      "Sid": "RegionalRuntimeRead",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:Describe*",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "NamedLoadBalancer",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroupAttributes"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:eu-north-1:938095765653:loadbalancer/app/flexexa-dev-charging-api/*",
        "arn:aws:elasticloadbalancing:eu-north-1:938095765653:targetgroup/flexexa-dev-charging-api/*",
        "arn:aws:elasticloadbalancing:eu-north-1:938095765653:listener/app/flexexa-dev-charging-api/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "NamedTaskDefinition",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:TagResource",
        "ecs:ListTagsForResource"
      ],
      "Resource": "arn:aws:ecs:eu-north-1:938095765653:task-definition/flexexa-dev-charging-api:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "NamedService",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DescribeServices",
        "ecs:TagResource",
        "ecs:ListTagsForResource"
      ],
      "Resource": "arn:aws:ecs:eu-north-1:938095765653:service/flexexa-dev/flexexa-dev-charging-api",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "TaggedNetworkCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:AllocateAddress",
        "ec2:CreateNatGateway"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "aws:RequestTag/Project": "flexexa",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "DevSecurityGroupRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:eu-north-1:938095765653:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "ec2:ResourceTag/Project": "flexexa",
          "ec2:ResourceTag/Environment": "dev"
        }
      }
    }
  ]
}
