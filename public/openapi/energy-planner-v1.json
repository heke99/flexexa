{
  "openapi": "3.1.0",
  "info": {
    "title": "Flexexa Energy Wizard planning",
    "version": "2026-11-12-v1",
    "description": "Stateless calculation only. No dispatch, identity, live evidence or reward allocation. Maximum 65536 request bytes. All durations are fixed UTC quarters, maximum 24 hours. Generic loads must be interruptible and continuously modulatable."
  },
  "servers": [
    {
      "url": "https://www.flexexa.com"
    }
  ],
  "paths": {
    "/api/v1/energy-wizard/plan": {
      "post": {
        "operationId": "planEnergy",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "https://www.flexexa.com"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "price_basis": {
                    "enum": [
                      "including_vat",
                      "excluding_vat"
                    ]
                  },
                  "slots": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 96,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "start": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Timezone required; quarter aligned."
                        },
                        "price_sek_per_kwh": {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 100
                        },
                        "available_kw": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 350
                        }
                      },
                      "required": [
                        "start",
                        "price_sek_per_kwh",
                        "available_kw"
                      ]
                    }
                  },
                  "assets": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "kind": {
                          "enum": [
                            "ev",
                            "load"
                          ]
                        },
                        "mode": {
                          "enum": [
                            "smart",
                            "now",
                            "paused"
                          ]
                        },
                        "available_from": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Timezone required; quarter aligned."
                        },
                        "deadline": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Timezone required; quarter aligned."
                        },
                        "max_kw": {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 350
                        },
                        "priority": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3
                        },
                        "battery_kwh": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 250
                        },
                        "soc_percent": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "target_percent": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "efficiency": {
                          "type": "number",
                          "minimum": 0.5,
                          "maximum": 1
                        },
                        "required_kwh": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 500
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "kind",
                        "mode",
                        "available_from",
                        "deadline",
                        "max_kw"
                      ],
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "kind": {
                                "const": "ev"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "battery_kwh",
                              "soc_percent",
                              "target_percent",
                              "efficiency"
                            ],
                            "not": {
                              "required": [
                                "required_kwh"
                              ]
                            }
                          },
                          "else": {
                            "required": [
                              "required_kwh"
                            ],
                            "not": {
                              "anyOf": [
                                {
                                  "required": [
                                    "battery_kwh"
                                  ]
                                },
                                {
                                  "required": [
                                    "soc_percent"
                                  ]
                                },
                                {
                                  "required": [
                                    "target_percent"
                                  ]
                                },
                                {
                                  "required": [
                                    "efficiency"
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "price_basis",
                  "slots",
                  "assets"
                ]
              },
              "example": {
                "price_basis": "including_vat",
                "slots": [
                  {
                    "start": "2026-11-12T00:00:00Z",
                    "price_sek_per_kwh": 2,
                    "available_kw": 4
                  },
                  {
                    "start": "2026-11-12T00:15:00Z",
                    "price_sek_per_kwh": 1,
                    "available_kw": 4
                  }
                ],
                "assets": [
                  {
                    "id": "car-1",
                    "name": "Bil 1",
                    "kind": "ev",
                    "mode": "smart",
                    "available_from": "2026-11-12T00:00:00Z",
                    "deadline": "2026-11-12T00:30:00Z",
                    "max_kw": 4,
                    "priority": 1,
                    "battery_kwh": 60,
                    "soc_percent": 30,
                    "target_percent": 33,
                    "efficiency": 0.9
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned proposal with execution=not_dispatched, per-asset unmet kWh and quarter actions. Feasible=false is a valid calculation, not success at charging.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "execution",
                    "feasible",
                    "assets",
                    "schedule",
                    "assumptions",
                    "warnings"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "execution": {
                      "const": "not_dispatched"
                    },
                    "feasible": {
                      "type": "boolean"
                    },
                    "assets": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "schedule": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid schema, time or limits"
          },
          "403": {
            "description": "Origin rejected"
          },
          "413": {
            "description": "Body too large"
          },
          "415": {
            "description": "JSON required"
          }
        }
      }
    }
  }
}
